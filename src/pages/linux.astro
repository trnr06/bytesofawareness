---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import '../styles/tutorial.css';

const linuxTutorials = (await getCollection('tutorials'))
	.filter((tutorial) => tutorial.data.category === 'Linux');
---

<BaseLayout title="Linux">

	<Hero
		title="Linux"
		description="Linux tutorials, command-line tips, scripting, system administration, and practical guides."
	/>

	<section class="content-section">
	<h2>Linux Tutorials</h2>

	<div class="tutorial-list">
		{linuxTutorials.map((tutorial) => (
			<article class="tutorial-card">
				<h3>{tutorial.data.title}</h3>

				<p>{tutorial.data.description}</p>

				<a class="tutorial-link" href={`/tutorials/${tutorial.id}/`}>
					Read Tutorial →
				</a>
			</article>
		))}
	</div>
	</section>
</BaseLayout>
