---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import '../styles/tutorial.css';

const aiTutorials = (await getCollection('tutorials'))
	.filter((tutorial) => tutorial.data.category === 'AI');
---

<BaseLayout title="AI">

	<Hero
		title="Artificial Intelligence"
		description="Local AI, machine learning, LLMs, automation, and practical AI experiments."
	/>

	<section class="content-section">
	<h2>AI Tutorials</h2>

	<div class="tutorial-list">
		{aiTutorials.map((tutorial) => (
			<article class="tutorial-card">
				<h3>{tutorial.data.title}</h3>

				<p>{tutorial.data.description}</p>

				<a class="tutorial-link" href={`/tutorials/${tutorial.id}/`}>
					Read Tutorial →
				</a>
			</article>
		))}
	</div>
	</section>
</BaseLayout>
