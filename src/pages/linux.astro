---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="Linux">

	<Hero
		title="Linux"
		description="Linux tutorials, command-line tips, scripting, system administration, and practical guides."
	/>

	<section class="content-section">
	<h2>Linux Tutorials</h2>

	<div class="tutorial-list">
		<article class="tutorial-card">
			<h3>Essential Linux Commands for Beginners</h3>

			<p>
				Learn the essential commands you'll use again and again
				while working in the Linux terminal.
			</p>

			<a class="tutorial-link" href="/tutorials/essential-linux-commands/">
				Read Tutorial →
			</a>
		</article>

		<article class="tutorial-card">
			<h3>Linux Files and Directories: A Hands-On Guide</h3>

			<p>
				Learn how Linux organizes files and directories and practice
				navigating and managing them from the terminal.
			</p>

			<a class="tutorial-link" href="/tutorials/files-and-directories/">
				Read Tutorial →
			</a>
		</article>
	</div>
	</section>
</BaseLayout>
